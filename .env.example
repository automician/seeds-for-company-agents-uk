# Усе машинне й облікове — тут, ніколи у файлах поля. Скопіюй у .env (він у .gitignore).

# Ключ API постачальника моделі — лише коли маршрут класу даних = API
# (company/data-routes.md). Ліміт витрат ставлять у консолі постачальника.
ANTHROPIC_API_KEY=

# Автоматичний перезапуск сесій (core/rehatch.sh, виростає із seeds/core/rehatch.md):
# тут лише два локальні перемикачі; поріг використання підписки чи витрат API —
# у company/sessions.md (крок 5 першого запуску).
REHATCH_MAX_SESSIONS_PER_DAY=4
REHATCH_STOP_FILE=.rehatch-stop
