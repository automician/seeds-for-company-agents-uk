# таємниці й локальне
.env
*.local.md
# сирі експорти відділів — класифікує людина, у поле йдуть лише data/<клас>/
tasks/inbox/exports/
# регульований і обмежений класи: без маршруту — не обробляти; теки лишаються порожніми
data/regulated/
data/restricted/
# копії репозиторіїв коду (зерно ІТ-розробки): у репозиторій міста код не копіюють
data/*/code/
# локальні файли наглядача перезапуску: журнал запусків і зупинний файл
core/rehatch.log
.rehatch-stop
.DS_Store
node_modules/
